# JengaForge Environment Configuration
# Server-side Gemini API key used for the intelligent AI Assistant (/api/chat).
# In production, users can also provide their personal BYOK API key in Profile settings.
GEMINI_API_KEY=

# Reverse Proxy Trust Configuration (0, 1, or proxy IP count)
TRUST_PROXY=1

# Firebase App Check (optional client-side reCAPTCHA v3 site key)
VITE_RECAPTCHA_SITE_KEY=
